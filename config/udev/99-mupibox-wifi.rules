# The WiFi's power saving off for every WiFi interface that appears: some drivers start with it on (rtw88 of the TP-Link
# Archer T2U PLUS, RTL8821AU), and an access point holds back the frames to a client that sleeps - the box is on all the
# time, with music streaming in. (The setting stays while the adapter is there; it is set again when it appears.)
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan*", RUN+="/usr/sbin/iw dev %k set power_save off"

# A WiFi interface appeared or disappeared (e.g. a USB WiFi adapter was plugged in or removed):
# let MuPiBox choose again which adapter to use (USB preferred, onboard as fallback).
# KillMode=process: the script starts the WiFi (wpa_supplicant, dhclient run in the background); systemd must
# not stop those together with the script when it ends, otherwise the link that was just set up goes down again.
ACTION=="add|remove", SUBSYSTEM=="net", KERNEL=="wlan*", RUN+="/usr/bin/systemd-run --no-block --property=KillMode=process /usr/local/bin/mupibox/mupi_wifi_select.sh"
