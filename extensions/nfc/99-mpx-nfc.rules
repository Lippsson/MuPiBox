# The SPI bus of the header: the NFC reader (PN5180) is driven by a program of the box's user, which is not in the group spi (the
# device is root:spi, mode 660). The group gpio is the one that user has for the header pins already.
SUBSYSTEM=="spidev", KERNEL=="spidev[0-9]*.[0-9]*", GROUP="gpio", MODE="0660"
